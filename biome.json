{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/drizzle",
      "!**/pnpm-lock.yaml",
      "!docs",
      "!apps/web/src/components/ui",
      "!apps/web/src/components/data-table/bulk-actions.tsx",
      "!apps/web/src/components/data-table/column-header.tsx",
      "!apps/web/src/components/data-table/pagination.tsx",
      "!apps/web/src/components/data-table/toolbar.tsx",
      "!apps/web/src/components/data-table/view-options.tsx",
      "!apps/web/src/components/layout/nav-group.tsx",
      "!apps/web/src/lib/utils.ts",
      "!apps/web/src/hooks/use-mobile.tsx",
      "!apps/web/src/assets/custom",
      "!apps/web/src/components/config-drawer.tsx",
      "!apps/web/src/context/direction-provider.tsx",
      "!apps/web/src/context/layout-provider.tsx",
      "!apps/web/src/context/theme-provider.tsx",
      "!apps/web/src/lib/cookies.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
