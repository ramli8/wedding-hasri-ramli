# Salin ke .env untuk pengembangan lokal (.env tidak masuk git).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://wedding:wedding@localhost:5433/wedding

# Origin yang boleh melakukan request yang mengubah data (dipisah koma).
ALLOWED_ORIGINS=http://localhost:5173

# Production: COOKIE_SECURE=true (wajib) dan TRUST_PROXY=true (di belakang Caddy/Cloudflare).
COOKIE_SECURE=false
TRUST_PROXY=false

LOG_LEVEL=info

# Folder penyimpanan gambar unggahan (relatif terhadap apps/api). Production: volume Docker, ikut backup.
MEDIA_DIR=data/media
