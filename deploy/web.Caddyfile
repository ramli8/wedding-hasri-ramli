# Di dalam stack: melayani file statis dan meneruskan /api ke API. TLS ditangani edge Caddy.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	# Gambar unggahan: API memberi Cache-Control immutable karena id-nya tidak pernah berubah isinya.
	handle /media/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
		}
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
