# Salin menjadi deploy/.env.prod dan deploy/.env.staging (file .env.* tidak masuk git).
STACK_NAME=prod
PUBLIC_ORIGIN=https://contoh.com
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-acak-panjang
APP_VERSION=dev

# --- Cadangan ke R2 (opsional; jalankan dengan --profile backup, lihat docs/backup.md) ---
# BACKUP_DEST=r2:nama-bucket/prod
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_INTERVAL_HOURS=6
# BACKUP_RETENTION_DAYS=30
# BACKUP_PING_URL=          # mis. https://hc-ping.com/<uuid>; dipanggil tiap berhasil, /fail bila gagal
