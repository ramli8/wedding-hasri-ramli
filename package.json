{
  "name": "wedding",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:db": "docker compose -f deploy/compose.dev.yaml up -d",
    "dev:db:down": "docker compose -f deploy/compose.dev.yaml down",
    "dev:api": "pnpm --filter @wedding/api dev",
    "dev:web": "pnpm --filter @wedding/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
