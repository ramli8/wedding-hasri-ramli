# Frontend Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Site URL — basis untuk OpenGraph image absolute (preview WhatsApp/dll)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development
NODE_ENV=development
NEXT_PUBLIC_DEMO_MODE=false

# Production Example:
# NEXT_PUBLIC_API_URL=https://your-backend-domain.com/v1
# NEXT_PUBLIC_WS_URL=wss://your-backend-domain.com
# NEXT_PUBLIC_APP_URL=https://your-invitation-domain.com

# Origin API untuk CORS backend (info — diterapkan di sisi backend)
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Label zona waktu acara di undangan (default: WIB)
# NEXT_PUBLIC_EVENT_TZ_LABEL=WIB
