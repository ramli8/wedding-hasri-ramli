# Pintu masuk tunggal VPS.
#
# 1. IP asli pengunjung ditentukan DI SINI dan diteruskan sebagai X-Client-Ip (header lama ditimpa).
#    Cf-Connecting-Ip hanya dipercaya bila permintaan benar-benar datang dari jaringan Cloudflare;
#    yang menembak IP VPS langsung tidak bisa memalsukan IP-nya untuk mengakali pembatas percobaan.
# 2. Hanya Cloudflare yang boleh masuk (`(cloudflare_only)`): serangan DDoS diserap Cloudflare, dan
#    penyerang yang tahu IP VPS tidak bisa melewatinya. Untuk akses langsung sementara (mis. sebelum
#    DNS Cloudflare aktif), isi EXTRA_ALLOWED_IPS di deploy/.env.edge, mis. "203.0.113.7/32".
# 3. Batas waktu koneksi menahan serangan koneksi lambat (slowloris) agar tidak menghabiskan slot.
# Daftar IP Cloudflare: https://www.cloudflare.com/ips/ (perbarui bila berubah; dipakai dua kali).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
		timeouts {
			read_header 10s
			# Unggahan foto (sampai ±25 MB) lewat sinyal seluler bisa lambat.
			read_body 2m
			idle 2m
		}
		max_header_size 32KB
	}
}

(cloudflare_only) {
	@direct {
		not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 127.0.0.1/32 {$EXTRA_ALLOWED_IPS:127.0.0.1/32}
		# Let's Encrypt memeriksa sertifikat lewat jalur ini.
		not path /.well-known/acme-challenge/*
	}
	# Putus tanpa jawaban: tidak membuang tenaga untuk lalu lintas yang tidak lewat Cloudflare.
	abort @direct
}

{$PROD_DOMAIN} {
	import cloudflare_only
	reverse_proxy prod-web:80 {
		header_up X-Client-Ip {client_ip}
	}
}

{$STAGING_DOMAIN} {
	import cloudflare_only
	reverse_proxy staging-web:80 {
		header_up X-Client-Ip {client_ip}
	}
}
